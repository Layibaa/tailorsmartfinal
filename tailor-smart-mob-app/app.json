{
  "expo": {
    "name": "Tailoring App",
    "slug": "tailoring-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "notification": {
        "vapidPublicKey": "BOsdGqYBirdW5cn9aB_7LGy-0IT_u1sdyo_2ynSec183Qkgrh2EkB9Xqf9G57fJA2DAoAtanfpu4JL3sBxaUivg"
      },
      "serviceWorkerPath": "./service-worker.js"  
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff"
        }
      ] 
    ],
    "extra": {
  "apiUrl": "http://localhost:8000/api/v1"
}

  }
}
